# Copiar este arquivo pra .env e preencher o que for usar.
# O .env NUNCA entra no git. Conferir no .gitignore antes de salvar chave aqui.

# Geracao de imagem por IA (scripts/gerar-imagem.js) — opcional
OPENAI_API_KEY=

# Publicacao automatica no Instagram e Facebook (/aprovar-post) — opcional
# So configurar se o volume justificar. Publicacao manual e o padrao.
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Coleta de posts de perfis de referencia (scripts/coletores/apify.py) — opcional, pago por uso
# Pegar em console.apify.com > Settings > API & Integrations > Personal API token
APIFY_TOKEN=

# Placar da propria conta (scripts/perfil-de-desempenho.py) — opcional, so leitura
# Token com instagram_basic + instagram_manage_insights, gerado no Graph API Explorer (developers.facebook.com)
META_ACCESS_TOKEN=
# ID da conta profissional do Instagram: GET me/accounts?fields=instagram_business_account no mesmo Explorer
META_IG_ACCOUNT_ID=
