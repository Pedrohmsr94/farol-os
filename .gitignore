# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.idea/
.vscode/

# Claude Code — sessões locais, não vão pro repo
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/
.claude/settings.local.json

# Dependências
node_modules/

# Temporários
*.log
*.tmp

# Drop zone — os arquivos que você joga aqui não sobem, só o README
dados/*
!dados/README.md

# Obsidian — layout local da janela
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Privado do cliente — nunca sobe pro GitHub
notas/privado/

# Log do radar automatico - so na maquina
pesquisa/radar/_log/

# Chaves de API - nunca sobem
.env

# Midia de terceiro coletada - pesada, expira, sem direito de republicar
pesquisa/referencias/midia/
pesquisa/referencias/perfis/*/top*.jpg
pesquisa/investigacoes/reels/*/video.*

# Download interrompido do yt-dlp
*.part
*.ytdl

# Audio bruto de reuniao - a transcricao sobe, o audio nao
*.m4a
*.mp3
*.wav
*.ogg
*.opus

# Cache do Python
__pycache__/

# Saida do teste do carrossel de exemplo - regenera a cada render
conteudo/exemplos/*/carrossel.html
conteudo/exemplos/*/modelo.css
conteudo/exemplos/*/instagram/
conteudo/exemplos/*/*.png
!conteudo/exemplos/*/_previa.png
